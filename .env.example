# Giriş (tek yönetici hesabı)
ADMIN_EMAIL=admin@temizaday.local
ADMIN_PASSWORD=degistir-beni
SECRET_KEY=uzun-rastgele-bir-deger

# LLM (boşsa süzgeç çalışır, LLM analizi kapalı kalır)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Yükleme sınırları
MAX_UPLOAD_MB=5
MAX_PAGES=30

# Enerji varsayımları (ölçümle değiştirin)
WH_PER_CALL=0.3
GRID_G_PER_KWH=475
CPU_WATTS=15
PROMPT_TOKENS=300
OUT_TOKENS=300

# Güvenlik / veri
DATA_KEY=                # boşsa data/.datakey otomatik üretilir (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
RETENTION_DAYS=0         # 0: CV metnini silme; N: N günden eski CV metinlerini sil
